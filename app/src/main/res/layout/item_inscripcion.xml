<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
xmlns:android="http://schemas.android.com/apk/res/android"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="horizontal"
android:padding="10dp"
android:layout_marginBottom="8dp"
android:background="#FFFFFF">

<!-- IMAGEN DEL CURSO -->
<ImageView
    android:id="@+id/imgCurso"
    android:layout_width="70dp"
    android:layout_height="70dp"
    android:scaleType="centerCrop"
    android:src="@android:drawable/ic_menu_gallery"
    android:contentDescription="Imagen del curso"/>

<LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical"
    android:layout_marginStart="10dp">

    <!-- NOMBRE DEL CURSO -->
    <TextView
        android:id="@+id/txtNombreCurso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nombre del curso"
        android:textColor="#222222"
        android:textSize="14sp"
        android:textStyle="bold"/>

    <!-- BARRA DE INSCRIPCIONES -->
    <ProgressBar
        android:id="@+id/pbInscripciones"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="5dp"
        android:max="50"
        android:progress="0"
        android:progressTint="#1765A0"/>

    <!-- DATOS DE INSCRIPCIONES -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/txtInscritos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 inscritos"
            android:textColor="#333333"
            android:textSize="11sp"/>

        <TextView
            android:id="@+id/txtCupo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="50 total"
            android:textColor="#333333"
            android:textSize="11sp"/>

    </LinearLayout>

</LinearLayout>

</LinearLayout>