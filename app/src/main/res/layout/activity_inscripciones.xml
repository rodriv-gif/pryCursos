<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:orientation="vertical">

    <!-- ENCABEZADO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#1765A0"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <TextView
            android:id="@+id/txtRegresar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Regresar"
            android:gravity="center"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="32sp"/>

        <TextView
            android:id="@+id/txtTitulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ESTADO DE INSCRIPCIONES"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <!-- FILTRO -->
    <Spinner
        android:id="@+id/spCarrera"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="12dp"
        android:background="#FFFFFF"
        android:paddingHorizontal="12dp"
        android:spinnerMode="dropdown"/>

    <!-- TOTAL -->
    <TextView
        android:id="@+id/txtTotalInscritos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:paddingHorizontal="16dp"
        android:paddingBottom="10dp"
        android:text="Total: 0"
        android:textColor="#333333"
        android:textSize="14sp"/>

    <!-- LISTA DE CURSOS -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="12dp">


        <!-- LISTA DINÁMICA DE CURSOS -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCursos"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="12dp"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

        <!-- MENSAJE Y REINTENTO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <Button
                android:id="@+id/btnReintentar"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#1765A0"
                android:text="REINTENTAR"
                android:textColor="#FFFFFF"
                android:visibility="gone"/>

        </LinearLayout>

    </FrameLayout>

    <!-- REGRESAR AL CATÁLOGO -->
    <Button
        android:id="@+id/btnVolverCatalogo"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#1765A0"
        android:text="VOLVER AL CATÁLOGO"
        android:textColor="#FFFFFF"
        android:textStyle="bold"/>

</LinearLayout>